# The receipt engine @codex-sovereign/jarus is a private package. It is not on
# the public registry and must never be published there.
#
# Both scopes are mapped because the final package name is not yet settled:
# GitHub Packages scopes a package to the owning account (lowercase), so the
# name may be @codex-sovereign/jarus or @blade2ai/jarus. Mapping both keeps
# that a configuration choice rather than a code change.
@codex-sovereign:registry=https://npm.pkg.github.com/
@blade2ai:registry=https://npm.pkg.github.com/

# Read token, supplied by the environment. Never commit a token to this file.
//npm.pkg.github.com/:_authToken=${JARUS_REGISTRY_TOKEN}
