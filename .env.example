# ---------------------------------------------------------------------------
# Sovereign Public Face — Environment Variables
# ---------------------------------------------------------------------------
# Copy this file to .env and fill in the values.
# For Vercel deployment, set these in the Vercel Dashboard → Settings → Environment Variables.
# ---------------------------------------------------------------------------

# Public origin (REQUIRED in production)
# Where Stripe returns the customer after checkout. Read from configuration and
# never from the request, because `Origin`/`Referer` are caller-controlled: a
# request carrying `Origin: https://evil.example` used to produce a checkout
# session that returned the paying customer to that host with the real
# CHECKOUT_SESSION_ID attached.
#
# Must be a bare https origin — scheme + host (+ port), with no path, query,
# fragment or userinfo. Checkout FAILS CLOSED when this is unset in production
# rather than guessing an origin, so set it before the first deploy.
#
# PROMOTION_PUBLIC_ORIGIN is accepted as an alias, and is what /api/promotion-fix
# already reads, so a deployment may set either one.
PUBLIC_BASE_URL="https://your-public-origin.example"
PROMOTION_PUBLIC_ORIGIN="https://your-public-origin.example"

# Stripe (REQUIRED for payments)
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Separate Stripe endpoint for /api/promotion-fix-webhook; set in Vercel, never in source.
PROMOTION_WEBHOOK_SECRET="whsec_..."

# Email (REQUIRED for transactional emails)
RESEND_API_KEY="re_..."

# Database (REQUIRED)
DATABASE_URL="postgres://..."

# OAuth (auto-configured by Manus platform)
JWT_SECRET="..."
OAUTH_SERVER_URL="..."
# The user-facing authorization page, NOT the token-exchange API above.
#
# Needed SERVER-side now: /api/oauth/start builds the authorization request and
# issues the CSRF nonce, because the nonce has to live in an httpOnly cookie the
# browser cannot write. The callback previously compared `state` to nothing,
# which let an attacker replay their own authorization code into a victim's
# browser and have the server mint a session for the attacker's account.
#
# VITE_OAUTH_PORTAL_URL is read as a fallback so an existing deployment that
# only sets the client-side name keeps working. Sign-in fails CLOSED with a 503
# when neither is set, rather than redirecting somewhere unverified.
OAUTH_PORTAL_URL="..."
VITE_OAUTH_PORTAL_URL="..."
OWNER_OPEN_ID="..."
VITE_APP_ID="codex-sovereign-systems"

# Runtime
NODE_ENV="production"
PORT="3000"

# Promotion Fix checkout is fail-closed in production. Keep this at HOLD (or
# unset) until the exact seller identity and payment authority are approved.
# Set the exact value ENABLED only as part of that approved production change.
PROMOTION_CHECKOUT_STATE="HOLD"

# Optional: Forge API (AI features)
BUILT_IN_FORGE_API_URL=""
BUILT_IN_FORGE_API_KEY=""

# ---------------------------------------------------------------------------
# Stripe receipt journal (Stage 4–5 RECORDED_ONLY — names only; values via secret store)
# Do NOT vendor private jarus/ into this repo. Pin via absolute path + SHA-256.
# ---------------------------------------------------------------------------
STRIPE_RECEIPT_DATABASE_URL="mysql://..."
JARUS_RECEIPT_ENGINE_PATH="/absolute/path/to/jarus/dist/index.js"
JARUS_RECEIPT_ENGINE_SHA256="hex-sha256-of-engine-entry-bytes"
STRIPE_RECEIPT_MODE="test"
STRIPE_RECEIPT_CONNECTOR_ID="stripe:default"
# STRIPE_RECEIPT_MYSQL_URI is CI/vitest durability ONLY — never inject as prod journal

# ---------------------------------------------------------------------------
# Rate limiting (Upstash Redis)
# ---------------------------------------------------------------------------
# Shared counter for /api/trpc, /api/oauth and the /api/promotion-fix envelope.
# It has to be shared rather than in-process: /api/* run as Vercel functions, so
# a per-instance counter spread across invocations limits nothing.
#
# These are OPTIONAL. With neither set, rate limiting is DISABLED — the server
# logs that loudly in production and keeps serving, rather than refusing every
# request over a missing variable. Set both to turn it on.
#
# The REST pair from the Upstash console, not the redis:// URL.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# How many reverse proxies sit in front of the long-running Express host.
#
# READ THIS BEFORE SETTING THE UPSTASH PAIR — on its own, Upstash is not enough.
#
# The host needs to tell callers apart to meter them. Behind a proxy every
# request arrives from the proxy's address, so keying on it would put ALL
# traffic in one bucket and throttle the whole site to a single caller's
# budget. Rather than do that, the limiter detects an infrastructure source
# address (loopback or RFC1918) and declines to meter, logging the reason. So
# with Upstash configured and this unset, /api/trpc and /api/oauth are NOT
# rate limited — check the logs at boot.
#
# Set it to the number of trusted hops; the limiter then reads that many entries
# from the END of X-Forwarded-For, which is the part a client cannot forge
# (each trusted proxy appends what it saw, so anything the client prepended
# sits to its left and is ignored). One edge or load balancer is usually 1.
#
# CURRENT SETTING: 1, applied by the `start` script in package.json, on Andy's
# instruction that one proxy sits in front of this deployment. The script uses
# ${RATE_LIMIT_TRUSTED_PROXIES:-1}, so a value set in the host's own
# environment still wins — change it there rather than editing the script.
#
# That is an ASSERTION ABOUT THE DEPLOYMENT, and it is worth stating what it
# costs if it is wrong. A host that is NOT behind a proxy would then trust the
# last X-Forwarded-For entry, which such a host's clients can set freely — so an
# attacker could both evade their own budget and exhaust another caller's by
# naming their address. Set it higher than the real number of proxies and the
# same applies. If this app is ever moved somewhere directly exposed, drop the
# value back to 0 or unset: an inert limiter is better than a forgeable one.
#
# `npm run dev` is deliberately unaffected — local development is directly
# exposed, so the socket address is the right key there.
#
# Vercel ignores this entirely: api/* use x-vercel-forwarded-for, which the
# platform overwrites and a client therefore cannot set.
# The hourly per-IP limit on promotion-fix 'prepare' is separate from Upstash and
# uses the salt below against Neon. Upstash does not replace it.
#
# PROMOTION_RATE_LIMIT_SALT was previously undocumented here, which is a trap:
# 'prepare' fails CLOSED with 503 CONFIGURATION_UNAVAILABLE when it is missing
# or shorter than 32 characters, so anyone provisioning from this file alone got
# a dead endpoint with a message that does not name the cause. It is an HMAC key
# over the caller's address so raw IPs are never stored — generate a random one
# (e.g. `openssl rand -hex 32`) and keep it stable, since changing it resets
# every in-flight window.
PROMOTION_RATE_LIMIT_SALT="at-least-32-characters-of-random-hex"
