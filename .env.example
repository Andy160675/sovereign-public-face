# ---------------------------------------------------------------------------
# Sovereign Public Face — Environment Variables
# ---------------------------------------------------------------------------
# Copy this file to .env and fill in the values.
# For Vercel deployment, set these in the Vercel Dashboard → Settings → Environment Variables.
# ---------------------------------------------------------------------------

# Stripe (REQUIRED for payments)
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Separate Stripe endpoint for /api/promotion-fix-webhook; set in Vercel, never in source.
PROMOTION_WEBHOOK_SECRET="whsec_..."

# Email (REQUIRED for transactional emails)
RESEND_API_KEY="re_..."

# Database (REQUIRED)
DATABASE_URL="postgres://..."

# OAuth (auto-configured by Manus platform)
JWT_SECRET="..."
OAUTH_SERVER_URL="..."
OWNER_OPEN_ID="..."
VITE_APP_ID="codex-sovereign-systems"

# Runtime
NODE_ENV="production"
PORT="3000"

# Optional: Forge API (AI features)
BUILT_IN_FORGE_API_URL=""
BUILT_IN_FORGE_API_KEY=""

# ---------------------------------------------------------------------------
# Stripe receipt journal (Stage 4–5 RECORDED_ONLY — names only; values via secret store)
# Do NOT vendor private jarus/ into this repo. Pin via absolute path + SHA-256.
# ---------------------------------------------------------------------------
STRIPE_RECEIPT_DATABASE_URL="mysql://..."
JARUS_RECEIPT_ENGINE_PATH="/absolute/path/to/jarus/dist/index.js"
JARUS_RECEIPT_ENGINE_SHA256="hex-sha256-of-engine-entry-bytes"
STRIPE_RECEIPT_MODE="test"
STRIPE_RECEIPT_CONNECTOR_ID="stripe:default"
# STRIPE_RECEIPT_MYSQL_URI is CI/vitest durability ONLY — never inject as prod journal
